<Window x:Class="PaperbellAppDotNet.CustomerHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riwayat customer"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom"
                Content="Tutup"
                Padding="16,6"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="BtnClose_Click"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="TxtCustomer"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtSummary"
                       TextWrapping="Wrap"
                       Foreground="#555"/>
        </StackPanel>

        <DataGrid x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tanggal" Binding="{Binding OrderCreatedText}" Width="130"/>
                <DataGridTextColumn Header="Order SN" Binding="{Binding OrderSn}" Width="180"/>
                <DataGridTextColumn Header="Produk" Binding="{Binding ItemName}" Width="*"/>
                <DataGridTextColumn Header="Variasi" Binding="{Binding ModelName}" Width="170"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
