<Window x:Class="PaperbellAppDotNet.RandomPagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Random pages (Planner / Loose Leaf)"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="#444"
                   Text="Ambil PDF dan grup (P/L) dari Data Map (XLSX) di folder config. Pilih sumber, jumlah halaman acak, dan ukuran kertas."/>

        <GroupBox Grid.Row="1" Header="Grup" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbPlanner" Content="Planner (P)" IsChecked="True" Margin="0,0,16,0" GroupName="GrpKind"/>
                <RadioButton x:Name="RbLoose" Content="Loose Leaf (L)" GroupName="GrpKind"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="PDF sumber (dari Data Map)" Padding="8" Margin="0,0,0,10">
            <ComboBox x:Name="CmbPdf" DisplayMemberPath="Display" MinHeight="28"/>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Jumlah halaman acak (N)" Padding="8">
                <TextBox x:Name="TxtCount" Text="5" VerticalContentAlignment="Center" Height="28"/>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Ukuran kertas" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbA5" Content="A5" IsChecked="True" Margin="0,0,12,0" GroupName="GrpPaper"/>
                    <RadioButton x:Name="RbB5" Content="B5" GroupName="GrpPaper"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="TxtHint" Grid.Row="4" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#666" FontSize="12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Batal" Width="88" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
